{
  "permissions": {
    "deny": [
      "Edit(legado/**)",
      "Read(**/.env)",
      "Read(**/*.pem)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "WebFetch",
      "Edit(/migracion/golden-master.csv)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardian.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && dotnet test --nologo 1>&2 || exit 2" }
        ]
      }
    ]
  }
}
